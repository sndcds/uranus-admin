{
  "openapi": "3.1.0",
  "info": {
    "title": "Kulturbytes Admin API",
    "description": "Internal reporting API. Production auth is unavailable in milestone 1.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process liveness",
        "description": "Confirms the HTTP process is running; does not access PostgreSQL.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Database readiness",
        "description": "Checks the database connection; does not certify auth or schema compatibility.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Dashboard summary",
        "description": "Source-table creations in [from_at, to_at), plus live venue findings. Today starts at midnight in ADMIN_TIMEZONE. Historical check status is unavailable.",
        "operationId": "summary_api_v1_dashboard_summary_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "today",
                "24h",
                "7d"
              ],
              "type": "string",
              "default": "24h",
              "title": "Period"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummary"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/findings": {
      "get": {
        "tags": [
          "Findings"
        ],
        "summary": "List live quality findings",
        "description": "Paginated current findings. Only open findings exist in live mode; other status filters return an empty live result, not historical workflow data. Ordered by severity, priority, publication relevance, observation time and stable ID.",
        "operationId": "findings_api_v1_findings_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Severity"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "name": "rule",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rule"
            }
          },
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organization Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FindingStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/quality/venues/missing-geolocation": {
      "get": {
        "tags": [
          "Quality"
        ],
        "summary": "Venues without a geolocation",
        "description": "Finds NULL/empty PostGIS points and counts upcoming dates by effective venue. Includes address, organization and publication relevance in the generic finding contract.",
        "operationId": "missing_geolocation_api_v1_quality_venues_missing_geolocation_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organization Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "properties": {
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street"
          },
          "house_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "House Number"
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Code"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "type": "object",
        "title": "Address"
      },
      "DashboardSummary": {
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "today",
              "24h",
              "7d"
            ],
            "title": "Period"
          },
          "from_at": {
            "type": "string",
            "format": "date-time",
            "title": "From At"
          },
          "to_at": {
            "type": "string",
            "format": "date-time",
            "title": "To At"
          },
          "admin_timezone": {
            "type": "string",
            "title": "Admin Timezone"
          },
          "source_timestamp_timezone": {
            "type": "string",
            "title": "Source Timestamp Timezone"
          },
          "new_records": {
            "$ref": "#/components/schemas/NewRecords"
          },
          "images_without_created_at": {
            "type": "integer",
            "title": "Images Without Created At"
          },
          "urgent_findings": {
            "type": "integer",
            "title": "Urgent Findings"
          },
          "quality": {
            "$ref": "#/components/schemas/QualityCounts"
          },
          "check_status": {
            "type": "null",
            "title": "Check Status"
          }
        },
        "type": "object",
        "required": [
          "period",
          "from_at",
          "to_at",
          "admin_timezone",
          "source_timestamp_timezone",
          "new_records",
          "images_without_created_at",
          "urgent_findings",
          "quality"
        ],
        "title": "DashboardSummary"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "priority": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Priority"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type"
          },
          "entity_key": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Entity Key"
          },
          "entity_name": {
            "type": "string",
            "title": "Entity Name"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          },
          "organization_name": {
            "type": "string",
            "title": "Organization Name"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus",
            "default": "open"
          },
          "first_seen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Seen At"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen At"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          },
          "upcoming_event_date_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Upcoming Event Date Count"
          },
          "upcoming_published_event_date_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Upcoming Published Event Date Count"
          },
          "soon_published_event_date_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Soon Published Event Date Count"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id",
            "deprecated": true,
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "rule",
          "severity",
          "priority",
          "entity_type",
          "entity_key",
          "entity_name",
          "organization_id",
          "organization_name",
          "field",
          "message",
          "address",
          "last_seen_at",
          "upcoming_event_date_count",
          "upcoming_published_event_date_count",
          "soon_published_event_date_count",
          "entity_id"
        ],
        "title": "Finding"
      },
      "FindingPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Items"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "mode": {
            "type": "string",
            "const": "live",
            "title": "Mode",
            "default": "live"
          }
        },
        "type": "object",
        "required": [
          "items",
          "pagination",
          "observed_at"
        ],
        "title": "FindingPage"
      },
      "FindingStatus": {
        "type": "string",
        "enum": [
          "open",
          "reviewed",
          "ignored",
          "resolved"
        ],
        "title": "FindingStatus"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "NewRecords": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "organizations": {
            "type": "integer",
            "title": "Organizations"
          },
          "venues": {
            "type": "integer",
            "title": "Venues"
          },
          "spaces": {
            "type": "integer",
            "title": "Spaces"
          },
          "events": {
            "type": "integer",
            "title": "Events"
          },
          "event_dates": {
            "type": "integer",
            "title": "Event Dates"
          },
          "users": {
            "type": "integer",
            "title": "Users"
          },
          "partner_requests": {
            "type": "integer",
            "title": "Partner Requests"
          },
          "team_memberships": {
            "type": "integer",
            "title": "Team Memberships"
          },
          "images": {
            "type": "integer",
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
          "total",
          "organizations",
          "venues",
          "spaces",
          "events",
          "event_dates",
          "users",
          "partner_requests",
          "team_memberships",
          "images"
        ],
        "title": "NewRecords"
      },
      "Pagination": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          }
        },
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total",
          "pages"
        ],
        "title": "Pagination"
      },
      "QualityCounts": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "errors": {
            "type": "integer",
            "title": "Errors",
            "default": 0
          },
          "warnings": {
            "type": "integer",
            "title": "Warnings"
          },
          "info": {
            "type": "integer",
            "title": "Info",
            "default": 0
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rules",
            "default": [
              "venue_missing_geolocation"
            ]
          },
          "mode": {
            "type": "string",
            "const": "live",
            "title": "Mode",
            "default": "live"
          }
        },
        "type": "object",
        "required": [
          "total",
          "warnings"
        ],
        "title": "QualityCounts"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "error",
          "warning",
          "info"
        ],
        "title": "Severity"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
