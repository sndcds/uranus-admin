NUXT_ADMIN_API_BASE=http://127.0.0.1:8000
# Optional manual Bearer entry in a local `pnpm dev` session only.
# No server-side admin key is configured or automatically attached.
NUXT_PUBLIC_ALLOW_DEV_TOKEN_ENTRY=false
# Optional exact trusted ingress socket IPs; ingress MUST overwrite X-Real-IP.
# Empty: use socket peer only. Never trust arbitrary browser X-Forwarded-For.
NUXT_TRUSTED_INGRESS_IPS=

# Public OSM Standard tiles; no own tile server or API key required.
# Override to change provider; an explicitly empty value disables tiles.
NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Additional provider credit as plain text and optional HTTPS link (never HTML).
NUXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NUXT_PUBLIC_MAP_TILE_ATTRIBUTION_URL=
