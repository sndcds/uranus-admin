[Unit]
Description=Restrict research pilot TLS listeners to Server A
Before=nginx.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/nft list table inet uranus_research_ai >/dev/null 2>&1 || /usr/sbin/nft -f /etc/uranus-research-ai/guard.nft'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
