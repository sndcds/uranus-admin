[Unit]
Description=Uranus Admin Frontend (Nuxt/Nitro)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oklab
Group=oklab
WorkingDirectory={{ ua_release_dir }}/frontend
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3011
Environment=NITRO_HOST=127.0.0.1
Environment=NITRO_PORT=3011
Environment=NUXT_ADMIN_API_BASE=http://127.0.0.1:8011
Environment=NUXT_PUBLIC_ALLOW_DEV_TOKEN_ENTRY=false
Environment=NUXT_TRUSTED_INGRESS_IPS=127.0.0.1
UnsetEnvironment=DATABASE_URL ADMIN_DATABASE_URL ADMIN_MIGRATION_DATABASE_URL ADMIN_AUTH_MANAGEMENT_DATABASE_URL DEV_ADMIN_TOKEN
ExecStart={{ ua_node }} {{ ua_release_dir }}/frontend/.output/server/index.mjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
