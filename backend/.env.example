APP_ENV=development
# Local server logs include exception details/tracebacks when true; API errors stay sanitized.
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Domain reader: SELECT only on Uranus; no domain writes, ownership or DDL.
# Example role names; replace change-me using your secret provisioning process.
# URL-encode reserved password characters, e.g. # -> %23 and + -> %2B.
DATABASE_URL=postgresql+asyncpg://uranus_reader:change-me@localhost:5432/uranus
# UTC storage confirmed by the operator for the supplied 2026-09-14 live backup.
URANUS_TIMESTAMP_TIMEZONE=UTC
ADMIN_TIMEZONE=Europe/Berlin
EVENT_TIMEZONE=Europe/Berlin
UPCOMING_DAYS=14
# Public Activity thumbnails/links for Kulturbytes source data (also on localhost):
# set URANUS_API_URL=https://api.kulturbytes.de. Authentication never calls Uranus.
URANUS_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TIMEOUT_SECONDS=10
OPENAPI_ENABLED=false
# DEVELOPMENT ONLY. Disabled by default; never accepted in staging/production.
DEV_AUTH_ENABLED=false
# DEV_ADMIN_TOKEN=<generate a random secret of at least 32 characters>
# Separate runtime role: admin workflow DML, no DDL or Uranus writes.
# record_mark_event: SELECT + INSERT only; never grant owner-role membership.
# Required for production authentication, persisted default lists, reviews and marks.
# auth_account/auth_system_admin: SELECT only; session/login-bucket: SELECT, INSERT, UPDATE.
# ADMIN_DATABASE_URL=postgresql+asyncpg://admin_user:change-me@localhost:5432/uranus
# Alembic only: owns admin schema/tables; never use this account for the runtime API.
# Supply in the migration process environment: Alembic does NOT load this .env file.
# ADMIN_MIGRATION_DATABASE_URL=postgresql+asyncpg://admin_migrator:change-me@localhost:5432/uranus
# Complete provisioning and verification: docs/development.md#minimale-rechte-nach-migration-0003

IMAGE_ORPHAN_GRACE_HOURS=48
PENDING_AGE_DAYS=14
ACTIVATION_AGE_DAYS=7

# Independent Admin login: exact browser origin, no trailing slash.
# Staging/production require HTTPS; use https://admin.example.invalid there.
AUTH_PUBLIC_ORIGIN=http://localhost:3000
AUTH_SESSION_SECONDS=3600
AUTH_IDLE_SECONDS=900
# Operator CLI ONLY. Do not supply this credential to the API service.
# ADMIN_AUTH_MANAGEMENT_DATABASE_URL=postgresql+asyncpg://admin_auth_operator:change-me@localhost:5432/uranus

# Activity public previews: URANUS_API_URL=https://api.kulturbytes.de enables verified
# Kulturbytes image/page links only for source data belonging to that public instance.
# Keep the existing local value for unrelated snapshots; no outbound auth/API calls are added.
